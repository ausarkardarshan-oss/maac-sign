# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production builds
frontend/dist/

# Environment variables
.env
backend/.env
frontend/.env
*.env.local

# Databases and runtime data
backend/database/
backend/storage/documents/*
!backend/storage/documents/.gitkeep
backend/storage/temporary/*
!backend/storage/temporary/.gitkeep
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS generated files
.DS_Store
Thumbs.db
