PORT=3001
NODE_ENV=development
COOKIE_SECURE=0
PUBLIC_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SESSION_MAX_AGE_MS=604800000
MONGODB_URI=mongodb://127.0.0.1:27017/maac-sign

# Brevo SMTP Configuration (Transactional Email)
# Obtain these from: Brevo Dashboard -> Transactional -> Settings -> Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email_or_smtp_user
SMTP_PASS=your_brevo_smtp_master_or_generated_key
SMTP_FROM="MAAC AI Sign <notifications@yourverifieddomain.com>"

# Optional Certificate-Based PDF Digital Signing (Phase 7)
# For production AATL trust, supply an X.509 certificate and private key.
SIGNING_CERT_PATH=
SIGNING_KEY_PATH=
SIGNING_PASSPHRASE=

